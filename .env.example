# Copy to .env.local for local development. Never commit real values.
# All of these are server-only: never prefix with NEXT_PUBLIC_.

# OpenRouter API key (starts with sk-or-). Required for the AI engine.
OPENROUTER_API_KEY=
# Optional. Defaults to NVIDIA Nemotron 3 Ultra on OpenRouter.
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional override of the OpenAI-compatible base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to "true" to allow /api/ai/* on non-protected hosts (custom domains). Leave unset until auth exists.
# AI_PUBLIC_ENABLED=

# Optional, server-only: raise rate limits for the live vulnerability feed.
# NVD_API_KEY=       (free key from nvd.nist.gov; default 5 requests / 30 s without one)
# GITHUB_TOKEN=      (fine-grained token, no scopes needed; default 60 requests / hour per IP without one)

# ---------------------------------------------------------------- Stage 6: database + auth
# Postgres connection string (Neon). Connect Neon in the Vercel dashboard (Storage) and Vercel injects it, or paste it here.
# Without it the app still works; database-backed pages show "Database not configured".
# Then run: npm run db:migrate
DATABASE_URL=

# Auth.js v5 with GitHub sign-in. All three are required to turn authentication on; until then the
# *.vercel.app SSO / localhost guard protects /api/ai/*, /api/scan and the private pages.
#   AUTH_SECRET: generate with `openssl rand -base64 32`
#   GitHub OAuth app callback URL: https://<your-domain>/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to sign in. Default: jhaelynjabbaar-lang
ADMIN_GITHUB_LOGINS=jhaelynjabbaar-lang

# ---------------------------------------------------------------- Stage 7: monitoring cron
# Shared secret for /api/cron/ingest (Authorization: Bearer <CRON_SECRET>). Vercel Cron sends this header automatically
# when the variable is set. With no value the cron route refuses all requests. Generate: `openssl rand -hex 32`.
# The Hobby plan allows one cron run per day (vercel.json: 06:17 UTC daily).
CRON_SECRET=
